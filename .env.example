# Generated from src/config/env/env.definition.ts -- do not edit by hand.
# Add or change a variable there, then run `pnpm env:sync`.

#== APP
# Runtime environment.
NODE_ENV=development
# HTTP port the API listens on.
PORT=3000
# Port exposed by the container for the microservice transport.
# Read by: docker-compose.yml
TRANSPORT_PORT=8080
# Locale used when the request asks for one we do not ship.
FALLBACK_LANGUAGE=en_US
# Log every SQL statement TypeORM executes.
ENABLE_ORM_LOGS=true
# Serve the Swagger UI at /documentation.
ENABLE_DOCUMENTATION=true
# Version string shown in the Swagger document.
API_VERSION=v1.0.0
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
# Public URL of the web client. Currently unused by the API.
FRONTEND_URL=http://localhost:3000
# Public base URL of this API. Currently unused by the API.
# API_BASE_URL=

#== JWT AUTH
# RS256 private key. Write newlines as literal \n to keep it on one line.
# Generate a keypair with: pnpm env:keygen
JWT_PRIVATE_KEY=
# RS256 public key, matching JWT_PRIVATE_KEY.
# Generate a keypair with: pnpm env:keygen
JWT_PUBLIC_KEY=
# Access-token lifetime, in seconds.
JWT_EXPIRATION_TIME=86400

#== DB
# Postgres host.
DB_HOST=127.0.0.1
# Postgres port.
DB_PORT=5432
# Postgres user. Also read by init-data.sh.
DB_USERNAME=postgres
# Postgres password. Also read by init-data.sh.
DB_PASSWORD=postgres
# Postgres database name. Also read by init-data.sh.
DB_DATABASE=awesome_nest_db

#== AWS S3
# Picked up implicitly by the AWS SDK credential chain.
# Read by: @aws-sdk credential chain
# AWS_ACCESS_KEY_ID=
# Picked up implicitly by the AWS SDK credential chain.
# Read by: @aws-sdk credential chain
# AWS_SECRET_ACCESS_KEY=
# Default region for the AWS SDK. S3 calls use AWS_S3_BUCKET_REGION instead.
# Read by: @aws-sdk credential chain
AWS_REGION=eu-central-1
# Bucket uploads are written to.
AWS_S3_BUCKET_NAME=deno-prod-upload
# Region of AWS_S3_BUCKET_NAME. Used to build public URLs.
AWS_S3_BUCKET_REGION=eu-central-1
# S3 API version pinned by the client.
AWS_S3_API_VERSION=2006-03-01
# ARN baked into the image as a build arg. Not read by the API.
# Read by: Dockerfile build arg
# SECRET_MANAGER_ARN=

#== NATS
# Start the NATS microservice transport alongside HTTP.
NATS_ENABLED=false
# NATS server host. Required when NATS_ENABLED is true.
NATS_HOST=localhost
# NATS server port. Required when NATS_ENABLED is true.
NATS_PORT=4222

#== THROTTLER
# Rate-limit window, e.g. 1m, 30s, 500ms.
THROTTLER_TTL=1m
# Requests allowed per THROTTLER_TTL window.
THROTTLER_LIMIT=10

#== REDIS
# Redis connection string. Not yet wired into application code.
# Read by: docker-compose redis service
# REDIS_URL=redis://localhost:6379
